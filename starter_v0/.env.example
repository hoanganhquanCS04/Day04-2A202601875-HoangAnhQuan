# Day 04 Lab v2 — Research Agent
# Copy this file to `.env` (same folder) and fill in your keys.
# NEVER commit `.env` — it is gitignored. Keys here are NAMES ONLY (no values).

# --- Model provider (choose ONE; this team uses YeScale) ---
# YeScale: OpenAI-compatible endpoint, run with `--provider yescale`
YESCALE_API_KEY=
# YESCALE_BASE_URL=https://api.yescale.io/v1   # optional override
# YESCALE_MODEL=gpt-4o-mini                    # optional override

# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Research / read tools ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_TWITTER_HOST=twitter-api45.p.rapidapi.com
ARXIV_USER_AGENT=AI20k-Day04-Research-Agent/1.0 (educational lab)

# --- Team tools (no API key required) ---
# weather   -> https://wttr.in
# currency  -> https://open.er-api.com
# crypto    -> https://api.coingecko.com

# --- Bonus delivery (optional, advanced track) ---
# Keep these UNSET while running run_eval.py so no message is ever sent during an eval.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
